MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0

# Comma separated list of frontend origins allowed to call the API
ALLOWED_ORIGIN=http://localhost:5173,https://minekart.vercel.app

JWT_SECRET=change-me

EMAIL_USER=you@gmail.com
EMAIL_PASS=gmail-app-password
EMAIL_BCC=you@gmail.com

# Realtime notifications (https://dashboard.pusher.com -> Channels app -> App Keys)
# Without these the frontend falls back to polling every 20 seconds
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap2

# Image uploads in production (Vercel -> Storage -> Blob). Added automatically when the store is connected.
# Leave empty locally to save uploads to public/uploads
BLOB_READ_WRITE_TOKEN=
